# Uso local únicamente. Nunca subir archivos .env con contraseñas.
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
DATABASE_URL=postgresql://nexodesk:nexodesk_local@localhost:5432/nexodesk

# Intelligence V2.6: local por defecto. La clave solo pertenece al backend.
INTELLIGENCE_EXTERNAL_ENABLED=false
OPENAI_API_KEY=
INTELLIGENCE_MODEL=gpt-6-luna
INTELLIGENCE_DAILY_TOKEN_BUDGET=20000
INTELLIGENCE_DAILY_REQUEST_LIMIT=20
INTELLIGENCE_USER_HOURLY_LIMIT=10

# SLA V2.7: 0 desactiva el worker; intervalo permitido 60..86400 segundos.
# El panel permite comprobar lotes manualmente aunque el worker esté apagado.
SLA_CHECK_INTERVAL_SECONDS=0
